{
  "name": "Mes4C2Extracteur",
  "version": "1.1.1",
  "description": "bien",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true});require('fs').copyFileSync('node_modules/html-to-image/dist/html-to-image.js','public/vendor/html-to-image.js')\"",
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.0",
    "@types/node-fetch": "^2.6.13",
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "abort-controller": "^3.0.0",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.3.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.tonorganisation.Mes4C2Extracteur",
    "productName": "Mes4C2Extracteur",
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sagnigit",
        "repo": "mes4c2Extracteur"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/assets/logo.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}